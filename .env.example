# Streamlit service port
PORT=8501

# Public demo safety switch. true => force offline/demo backend in UI.
DEMO_MODE=true

# Allows live CLIP runs when DEMO_MODE=false.
ALLOW_LIVE_RUNS=false

# Optional Hugging Face token for gated/private model access.
HF_TOKEN=

# Shown in dashboard runtime status (for deployment observability).
DEFAULT_CONFIG_PATH=evals/config.yaml
REPORTS_DIR=reports
